# Copy this file to .env and adjust when needed.
#
# Leave it empty to use the Vite dev proxy (/api -> http://localhost:8080),
# which keeps the session cookie same-origin and avoids CORS entirely in
# development.
VITE_API_BASE_URL=

# Only needed when the API is served from another origin, e.g.
# VITE_API_BASE_URL=http://localhost:8080/api
# (the backend must then list this app's origin in
#  CORS_ALLOWED_ORIGINS, see backend/.env.example)
