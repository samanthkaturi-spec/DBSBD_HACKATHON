# =====================================================================
#  Smart Leave Management System - backend environment template
#
#  Copy to `backend/.env` (git-ignored) and export before starting the
#  server. Spring Boot reads plain environment variables, it does NOT
#  parse this file by itself - one way to load it:
#
#      set -a; source backend/.env; set +a
#      cd backend && mvn spring-boot:run
#
#  Every value below is also the built-in default, so an empty file (or
#  no file at all) works against a local MySQL with root/no password.
#  NEVER commit real credentials.
#  =====================================================================

# ---------------------------- MySQL ---------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_leave_management
DB_USER=root
DB_PASSWORD=

# ---------------------------- Security ------------------------------
# Leave empty for local development: JwtService then generates an
# ephemeral secret at startup (tokens die on restart). Set a long random
# value in production so tokens survive restarts.
JWT_SECRET=
# Token lifetime in milliseconds (default 24 hours)
JWT_EXPIRATION_MS=86400000
# Comma separated list of browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# ---------------------------- Server --------------------------------
SERVER_PORT=8080

# ---------------------------- Optional ------------------------------
# Extra Spring property (set as an environment variable with the usual
# relaxed binding, or add it to src/main/resources/application.properties):
#   allow cancelling leave that has already started (default false)
# SMARTLEAVE_CANCELLATION_ALLOWAFTERSTART=false
